# Generated public configuration inventory. Copy this file to .env and uncomment only what you use.
# DashScope services use DASHSCOPE_API_KEY; MODEL_API_KEY is only a custom gateway override.
# Qwen Audio 3.1 uses QWEN_REALTIME_MODEL=qwen-audio-3.1-realtime-plus and matching voice longanqian_v3.1.
# StepAudio 3 uses INTEGRATED_PROVIDER=stepfun and STEPFUN_API_KEY for voice and auxiliary chat. Local memory embeddings still require a configured embedding service.
# DOUBAO_BIGMODEL_API_KEY is the Volcengine TTS key; ASR reuse requires resource permission.
# HA_* and AUTOGLM_* are retired in Node; nonempty legacy values produce a safe migration error.
# BEGIN GENERATED ENV CONTRACT
# --- OpenAI-compatible providers — independent credentials for each stage ---
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_PROTOCOL=chat-completions
# COMPATIBLE_ASR_BASE_URL=https://api.openai.com/v1
# COMPATIBLE_ASR_API_KEY=
# COMPATIBLE_ASR_MODEL=whisper-1
# COMPATIBLE_ASR_OMIT_RESPONSE_FORMAT=false
# COMPATIBLE_TTS_BASE_URL=https://api.openai.com/v1
# COMPATIBLE_TTS_API_KEY=
# COMPATIBLE_TTS_MODEL=tts-1
# COMPATIBLE_TTS_VOICE=alloy
# COMPATIBLE_TTS_SEND_SAMPLE_RATE=false

# --- Credentials — fill only for the services you use ---
# DASHSCOPE_API_KEY=
# STEPFUN_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# ARK_API_KEY=
# DOUBAO_BIGMODEL_API_KEY=
# TAVILY_API_KEY=
# OPENROUTER_API_KEY=
