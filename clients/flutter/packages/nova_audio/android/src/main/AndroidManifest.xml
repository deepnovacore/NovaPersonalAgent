<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application>
        <service android:name="com.nova.nova_audio.VoiceCallService"
            android:exported="false" android:foregroundServiceType="microphone"
            android:stopWithTask="true" />
        <service android:name="com.nova.nova_audio.VoicePetService"
            android:exported="false" android:foregroundServiceType="specialUse"
            android:stopWithTask="true">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started phone task floating progress and takeover controls outside Nova; no microphone use" />
        </service>
    </application>
</manifest>
